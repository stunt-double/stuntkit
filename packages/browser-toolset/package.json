{
  "name": "@stunt-double/browser-toolset",
  "version": "0.1.0",
  "description": "Browser tools for AI agents over a provider-neutral BrowserDriver: an executor for Anthropic's browser use toolset, provider-neutral function tools, and opt-in guards that refuse payments, sign-ups and secrets",
  "keywords": [
    "ai",
    "agents",
    "browser",
    "browser-use",
    "computer-use",
    "anthropic",
    "claude",
    "playwright",
    "tools",
    "llm"
  ],
  "license": "Apache-2.0",
  "author": "Turnout Labs Ltd",
  "homepage": "https://github.com/stunt-double/stuntkit/tree/main/packages/browser-toolset#readme",
  "bugs": {
    "url": "https://github.com/stunt-double/stuntkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stunt-double/stuntkit.git",
    "directory": "packages/browser-toolset"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@stunt-double/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./driver": {
      "@stunt-double/source": "./src/driver.ts",
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./executor": {
      "@stunt-double/source": "./src/executor.ts",
      "types": "./dist/executor.d.ts",
      "default": "./dist/executor.js"
    },
    "./keys": {
      "@stunt-double/source": "./src/keys.ts",
      "types": "./dist/keys.d.ts",
      "default": "./dist/keys.js"
    },
    "./page-script": {
      "@stunt-double/source": "./src/page-script.ts",
      "types": "./dist/page-script.d.ts",
      "default": "./dist/page-script.js"
    },
    "./direct-tools": {
      "@stunt-double/source": "./src/direct-tools.ts",
      "types": "./dist/direct-tools.d.ts",
      "default": "./dist/direct-tools.js"
    },
    "./safety": {
      "@stunt-double/source": "./src/safety.ts",
      "types": "./dist/safety.d.ts",
      "default": "./dist/safety.js"
    },
    "./prune": {
      "@stunt-double/source": "./src/prune.ts",
      "types": "./dist/prune.d.ts",
      "default": "./dist/prune.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.130.0",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "ai": "^7.0.135"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
