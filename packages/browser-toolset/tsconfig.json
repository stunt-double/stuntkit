{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    // `node --test` needs the explicit `.ts` extension under native type
    // stripping; the package is consumed as source and never emitted.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
