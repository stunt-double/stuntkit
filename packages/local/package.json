{
  "name": "stuntdouble",
  "version": "0.1.1",
  "description": "Stunt Double Local: run Stunt Double checklists in a local Chrome from your own coding agent session, with the runs kept as files and a local viewer",
  "keywords": [
    "stunt-double",
    "testing",
    "browser",
    "checklist",
    "mcp",
    "playwright",
    "agents"
  ],
  "license": "Apache-2.0",
  "author": "Turnout Labs Ltd",
  "homepage": "https://github.com/stunt-double/stuntkit/tree/main/packages/local#readme",
  "bugs": {
    "url": "https://github.com/stunt-double/stuntkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stunt-double/stuntkit.git",
    "directory": "packages/local"
  },
  "type": "module",
  "bin": {
    "stuntdouble": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc -p tsconfig.json",
    "test": "node --conditions=@stunt-double/source --test \"test/**/*.test.ts\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stunt-double/browser-toolset": "workspace:*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  }
}
